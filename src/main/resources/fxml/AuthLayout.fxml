<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="messagerie_instantanee.UI.controllers.AuthLayoutController"
           styleClass="login-root">

    <!-- Fond dégradé (non-interactif) -->
    <VBox mouseTransparent="true">
        <children>
            <Region VBox.vgrow="ALWAYS" styleClass="bg-top"    prefHeight="2000.0"/>
            <Region VBox.vgrow="ALWAYS" styleClass="bg-bottom" prefHeight="2000.0"/>
        </children>
    </VBox>

    <!-- Zone de contenu variable Login / Register — occupe tout l'espace -->
    <StackPane fx:id="contentArea" pickOnBounds="false"/>

    <!--
        Sidebar flottante — TOP_RIGHT, par-dessus le contenu.
        managed="false" + visible="false" : n'occupe aucune place dans le layout.
        Le décalage top compense la TopBar (même logique que la Notification).
    -->
    <VBox fx:id="sidebarMenu"
          styleClass="sidebar-right"
          visible="false"
          managed="false"
          maxHeight="Infinity"
          maxWidth="-Infinity"
          StackPane.alignment="CENTER_RIGHT">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="25.0"/>
        </padding>
        <children>
            <VBox>
                <!-- titre -->
                <Label text="Serveur(s) utilisé(s)" styleClass="sidebar-title"/>
                <!-- liste des marque page -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS" styleClass="sidebar-scroll">
                    <content>
                        <ListView fx:id="BookMarkList" styleClass="sidebar-list"/>
                    </content>
                </ScrollPane>
            </VBox>
        </children>
    </VBox>

    <!-- TopBar — ancrée TOP_RIGHT -->
    <fx:include fx:id="topBar"
                source="TopBar.fxml"
                StackPane.alignment="TOP_RIGHT"
                maxHeight="-Infinity"/>

    <!-- Notification flottante — TOP_RIGHT, décalée sous la TopBar par le controller -->
    <fx:include fx:id="notification"
                source="Notification.fxml"
                StackPane.alignment="TOP_RIGHT"
                maxHeight="-Infinity"/>

</StackPane>
