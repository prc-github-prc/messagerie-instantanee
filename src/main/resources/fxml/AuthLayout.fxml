<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="messagerie_instantanee.UI.controllers.AuthLayoutController"
           styleClass="login-root">

    <!-- Fond dégradé (non-interactif) -->
    <VBox mouseTransparent="true">
        <children>
            <Region VBox.vgrow="ALWAYS" styleClass="bg-top"    prefHeight="2000.0"/>
            <Region VBox.vgrow="ALWAYS" styleClass="bg-bottom" prefHeight="2000.0"/>
        </children>
    </VBox>

    <!-- Layout principal -->
    <BorderPane pickOnBounds="false">

        <!-- Sidebar droite masquée par défaut -->
        <right>
            <VBox fx:id="sidebarMenu"
                  prefWidth="300.0"
                  styleClass="sidebar-right"
                  visible="false"
                  managed="false">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="25.0"/>
                </padding>
                <children>
                    <Label text="Serveur(s) utilisé(s)" styleClass="sidebar-title"/>
                </children>
            </VBox>
        </right>

        <!-- Zone de contenu variable Login / Register -->
        <center>
            <StackPane fx:id="contentArea" pickOnBounds="false"/>
        </center>

    </BorderPane>

    <!--
        TopBar et Notification : fx:include SANS éléments enfants.
        Le StackPane.alignment est un attribut XML valide sur fx:include.
        La marge de la notification est appliquée programmatiquement
        dans AuthLayoutController.initialize() via StackPane.setMargin().
    -->

    <!-- TopBar — ancré TOP_RIGHT -->
    <fx:include fx:id="topBar"
                source="TopBar.fxml"
                StackPane.alignment="TOP_RIGHT"/>

    <!-- Notification flottante — TOP_RIGHT, décalée sous la TopBar par le controller -->
    <fx:include fx:id="notification"
                source="Notification.fxml"
                StackPane.alignment="TOP_RIGHT"/>

</StackPane>
