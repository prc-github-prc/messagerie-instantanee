<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.Hyperlink?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="chat-root" 
    stylesheets="@../css/style.css" 
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="messagerie_instantanee.UI.controllers.ChatController">  

    <!-- ==================== Layout du coté gauche (liste discussion, compte, creation) ==================== -->
    <left>
        <VBox prefWidth="350.0" styleClass="sidebar" spacing="15">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="25.0" />
            </padding>
            <children>
                <!-- ==================== affichage du compte connecter ==================== -->
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15px 0;">
                    <children>
                        <Circle radius="20.0" fill="#2f55d4" styleClass="logo-circle" /> 
                        <Button fx:id="usernameLink" 
                                text="Vivi" 
                                onAction="#doNothings"  
                                styleClass="profile-name-link" 
                                HBox.hgrow="ALWAYS" 
                                maxWidth="Infinity"/>
                    </children>
                </HBox>

                <!-- ==================== Bar de recherche ==================== -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="searchField" 
                            promptText="Rechercher..." 
                            styleClass="chat-input" 
                            HBox.hgrow="ALWAYS" />
                        <Button styleClass="search-btn">
                            <graphic>
                                <StackPane>
                                    <children>
                                        <SVGPath content="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" 
                                                stroke="#EDE3E3" 
                                                strokeWidth="2.0" 
                                                strokeLineCap="ROUND" 
                                                strokeLineJoin="ROUND" 
                                                fill="transparent" />
                                        <SVGPath content="M21 21L16.65 16.65" 
                                                stroke="#EDE3E3" 
                                                strokeWidth="2.0" 
                                                strokeLineCap="ROUND" 
                                                strokeLineJoin="ROUND" 
                                                fill="transparent" />
                                    </children>
                                </StackPane>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <Label styleClass="sidebar-title" text="FORUM DISCUSSION" />
                <Label styleClass="section-title" text="SALONS DISPONIBLES" />
                
                <!-- ==================== Layout des salon ==================== -->
                <ScrollPane fitToWidth="true" 
                            hbarPolicy="NEVER" 
                            vbarPolicy="AS_NEEDED" 
                            VBox.vgrow="ALWAYS" 
                            styleClass="sidebar-scroll">
                    <content>
                        <ListView fx:id="salonList" styleClass="sidebar-list"/>
                    </content>
                </ScrollPane>
                
                <!-- ==================== zone de creation ==================== -->
                <Line startX="0.0" startY="0.0" endX="320.0" endY="0.0" stroke="#EAD3D3" strokeWidth="2.0" />


                <VBox spacing="10" style="-fx-padding: 15px 0 5px 0;">
                    <children>
                        <Button text="+ Ajouter un tag" onAction="#createNewTag" styleClass="sidebar-btn" maxWidth="Infinity"/>
                        <Button text="+ Créer un salon" onAction="#createNewSalon" styleClass="sidebar-btn" maxWidth="Infinity"/>
                    </children>
                </VBox>
                
                <Line startX="0.0" startY="0.0" endX="320.0" endY="0.0" stroke="#EAD3D3" strokeWidth="2.0" />
                
                <!-- ==================== la roue crante du bas ==================== -->
                <Button onAction="#doNothings" styleClass="settings-btn-container"> 
                    <graphic>
                        <StackPane styleClass="settings-icon-wrapper">
                            <children>
                                <FontIcon iconLiteral="fas-cog" iconSize="20" iconColor="white"/>
                            </children>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- ======================================== Layout de la discussion  ======================================== -->
    <center>
        <VBox styleClass="chat-area" BorderPane.alignment="CENTER">
            <children>
                <!-- ==================== affichage du header du salon ==================== -->
                <VBox alignment="CENTER_LEFT" styleClass="chat-header">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                    <children>
                        <Label fx:id="titreLabel" styleClass="chat-title" text="# Sélectionnez un salon" />
                        <Label fx:id="tagsLabel" styleClass="chat-subtitle" text="Choisis un salon à gauche pour commencer à discuter" />
                    </children>
                </VBox>

                <!-- ==================== affichage la list des message ==================== -->
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="chat-scroll">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <content>
                        <VBox fx:id="messagesBox" spacing="12" styleClass="messages-container" />
                    </content>
                </ScrollPane>

                <!-- ==================== zone pour ecrire un message ==================== -->
                <HBox alignment="CENTER" spacing="12" styleClass="input-bar">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <children>
                        <TextField fx:id="inputField" 
                            onAction="#actionEnvoi" 
                            promptText="Écrire un message dans ce salon…" 
                            styleClass="chat-input" 
                            HBox.hgrow="ALWAYS" />
                        <Button onAction="#actionEnvoi" styleClass="envoi-btn-container">
                            <graphic>
                                <StackPane>
                                    <children>
                                        <FontIcon iconLiteral="fas-paper-plane" iconSize="30" iconColor="white"/>
                                        <!-- <SVGPath content="M 40.5 0 A 40.5 39 0 1 1 40.499 0 Z" fill="#40203B" />
                                        <SVGPath content="M76.9999 40.9976L38.4999 41.9142 M76.9999 40.9976L31.8598 64.781L38.4999 41.9142L27.64 19.4642L76.9999 40.9976Z" 
                                                stroke="#FB11FF" 
                                                strokeWidth="2.0" 
                                                strokeLineCap="ROUND" 
                                                strokeLineJoin="ROUND" 
                                                fill="transparent" /> -->
                                    </children>
                                </StackPane>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>