<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.Hyperlink?>

<BorderPane styleClass="chat-root" 
    stylesheets="@../css/style.css" 
    xmlns="http://javafx.com/javafx" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="messagerie_instantanee.UI.controllers.ChatControler">  

    <!-- ==================== Layout du coté gauche (liste discussion, compte, creation) ==================== -->
    <left>
        <VBox prefWidth="350.0" styleClass="sidebar" spacing="15">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="25.0" />
            </padding>
            <children>
                <!-- ==================== affichage du compte connecter ==================== -->
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15px 0;">
                    <children>
                        <Circle radius="20.0" fill="#2f55d4" styleClass="logo-circle" /> 
                        <Button fx:id="usernameLink" 
                                text="Vivi" 
                                onAction="#handleCreerSalon"  
                                styleClass="profile-name-link" 
                                HBox.hgrow="ALWAYS" 
                                maxWidth="Infinity"/>
                    </children>
                </HBox>

                <!-- ==================== Bar de recherche ==================== -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="searchField" 
                            promptText="Rechercher..." 
                            styleClass="chat-input" 
                            HBox.hgrow="ALWAYS" />
                        <Button styleClass="search-btn">
                            <graphic>
                                <StackPane>
                                    <children>
                                        <SVGPath content="M11 19C15.4183 19 19 15.4183 19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19Z" 
                                                stroke="#EDE3E3" 
                                                strokeWidth="2.0" 
                                                strokeLineCap="ROUND" 
                                                strokeLineJoin="ROUND" 
                                                fill="transparent" />
                                        <SVGPath content="M21 21L16.65 16.65" 
                                                stroke="#EDE3E3" 
                                                strokeWidth="2.0" 
                                                strokeLineCap="ROUND" 
                                                strokeLineJoin="ROUND" 
                                                fill="transparent" />
                                    </children>
                                </StackPane>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <Label styleClass="sidebar-title" text="FORUM DISCUSSION" />
                <Label styleClass="section-title" text="SALONS DISPONIBLES" />
                
                <!-- ==================== Layout des salon ==================== -->
                <ScrollPane fitToWidth="true" 
                            hbarPolicy="NEVER" 
                            vbarPolicy="AS_NEEDED" 
                            VBox.vgrow="ALWAYS" 
                            styleClass="sidebar-scroll">
                    <content>
                        <ListView fx:id="salonList" styleClass="sidebar-list" onMouseClicked="#currentSalon" />
                    </content>
                </ScrollPane>
                
                <!-- ==================== zone de creation ==================== -->
                <Line startX="0.0" startY="0.0" endX="320.0" endY="0.0" stroke="#EAD3D3" strokeWidth="2.0" />


                <VBox spacing="10" style="-fx-padding: 15px 0 5px 0;">
                    <children>
                        <Button text="+ Ajouter un tag" onAction="#handleAjouterTag" styleClass="sidebar-btn" maxWidth="Infinity"/>
                        <Button text="+ Créer une discussion" onAction="#handleCreerDiscussion" styleClass="sidebar-btn" maxWidth="Infinity"/>
                        <Button text="+ Créer un salon" onAction="#handleCreerSalon" styleClass="sidebar-btn" maxWidth="Infinity"/>
                        <Button text="+ Créer un serveur" onAction="#handleCreerServeur" styleClass="sidebar-btn" maxWidth="Infinity"/>
                    </children>
                </VBox>
                
                <Line startX="0.0" startY="0.0" endX="320.0" endY="0.0" stroke="#EAD3D3" strokeWidth="2.0" />
                
                <!-- ==================== la roue crante du bas ==================== -->
                <Button onAction="#handleCreerServeur" styleClass="settings-btn-container"> 
                    <graphic>
                        <StackPane styleClass="settings-icon-wrapper">
                            <children>
                                <SVGPath content="M33.5 38.75C38.1254 38.75 41.875 35.2802 41.875 31C41.875 26.7198 38.1254 23.25 33.5 23.25C28.8746 23.25 25.125 26.7198 25.125 31C25.125 35.2802 28.8746 38.75 33.5 38.75Z M54.1583 38.75C53.7867 39.5292 53.6758 40.3935 53.84 41.2315C54.0042 42.0695 54.436 42.8428 55.0795 43.4516L55.247 43.6066C55.7662 44.0865 56.178 44.6563 56.459 45.2835C56.7399 45.9108 56.8846 46.5831 56.8846 47.2621C56.8846 47.941 56.7399 48.6134 56.459 49.2406C56.178 49.8678 55.7662 50.4376 55.247 50.9175C54.7285 51.3979 54.1127 51.7789 53.4349 52.039C52.7571 52.299 52.0306 52.4328 51.2968 52.4328C50.5631 52.4328 49.8366 52.299 49.1588 52.039C48.4809 51.7789 47.8652 51.3979 47.3466 50.9175L47.1791 50.7625C46.5212 50.1669 45.6855 49.7674 44.7799 49.6155C43.8743 49.4635 42.9403 49.5661 42.0983 49.91C41.2726 50.2374 40.5684 50.7812 40.0724 51.4743C39.5764 52.1674 39.3102 52.9795 39.3102 53.8108V54.25C39.3102 55.6203 38.7184 56.9344 37.6713 57.9034C36.6242 58.8723 35.2041 59.4166 33.7233 59.4166C32.2425 59.4166 30.8224 58.8723 29.7753 57.9034C28.7282 56.9344 28.14 55.6203 28.14 54.25V54.0175C28.1183 53.1624 27.8192 52.3331 27.2816 51.6375C26.7439 50.9418 25.9924 50.4119 25.125 50.1166C24.2829 49.7728 23.3489 49.6702 22.4433 49.8221C21.5377 49.9741 20.7021 50.3736 20.0441 50.9691L19.8766 51.1241C19.3581 51.6045 18.7423 51.9856 18.0645 52.2456C17.3867 52.5056 16.6602 52.6395 15.9264 52.6395C15.1927 52.6395 14.4661 52.5056 13.7883 52.2456C13.1105 51.9856 12.4948 51.6045 11.9762 51.1241C11.4571 50.6443 11.0453 50.0745 10.7643 49.4473C10.4833 48.82 10.3387 48.1477 10.3387 47.4687C10.3387 46.7897 10.4833 46.1174 10.7643 45.4902C11.0453 44.863 11.4571 44.2932 11.9762 43.8133L12.1437 43.6583C12.7873 43.0495 13.219 42.2762 13.3832 41.4382C13.5474 40.6001 13.4366 39.7358 13.065 38.9566C12.7111 38.1926 12.1235 37.5409 11.3745 37.0819C10.6255 36.6229 9.74786 36.3766 8.84954 36.3733H8.37496C6.89417 36.3733 5.47402 35.829 4.42695 34.86C3.37987 33.8911 2.79163 32.57