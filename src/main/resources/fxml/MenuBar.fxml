<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.CheckMenuItem?>

<MenuBar xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:id="menuBar"
         fx:controller="messagerie_instantanee.UI.controllers.MenuBarController"
         useSystemMenuBar="false"
         styleClass="app-menubar">

    <menus>

        <!-- ══════════════════════════════════════════════════ Fichier ══ -->
        <Menu text="Fichier">
            <items>
                <MenuItem text="Se déconnecter"
                          onAction="#handleDeconnexion"
                          accelerator="SHORTCUT+Q"/>
                <SeparatorMenuItem/>
                <MenuItem text="Quitter"
                          onAction="#handleQuitter"
                          accelerator="SHORTCUT+W"/>
            </items>
        </Menu>

        <!-- ══════════════════════════════════════════════════ Discussion ══ -->
        <Menu text="Discussion">
            <items>
                <MenuItem text="Nouveau salon…"
                          onAction="#handleNouveauSalon"
                          accelerator="SHORTCUT+N"/>
                <MenuItem text="Ajouter un tag…"
                          onAction="#handleNouveauTag"
                          accelerator="SHORTCUT+T"/>
                <SeparatorMenuItem/>
                <MenuItem text="Rafraîchir les salons"
                          onAction="#handleRafraichir"
                          accelerator="F5"/>
            </items>
        </Menu>

        <!-- ══════════════════════════════════════════════════ Affichage ══ -->
        <Menu text="Affichage">
            <items>
                <CheckMenuItem fx:id="darkThemeItem"
                               text="Thème sombre"
                               onAction="#handleToggleTheme"
                               selected="true"
                               accelerator="SHORTCUT+D"/>
                <SeparatorMenuItem/>
                <CheckMenuItem fx:id="fullscreenItem"
                               text="Plein écran"
                               onAction="#handleToggleFullscreen"
                               accelerator="F11"/>
            </items>
        </Menu>

        <!-- ══════════════════════════════════════════════════ Aide ══ -->
        <Menu text="Aide">
            <items>
                <MenuItem text="À propos"
                          onAction="#handleAPropos"/>
            </items>
        </Menu>

    </menus>

</MenuBar>
