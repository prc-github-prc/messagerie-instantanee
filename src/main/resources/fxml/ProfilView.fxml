<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.TextField?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="messagerie_instantanee.UI.controllers.ProfileController"
            stylesheets="@../css/style.css"
            styleClass="chat-root">

    <!-- ========================= HEADER ========================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="chat-header">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <children>

                <!-- ===== Bouton Retour ===== -->

                <Button fx:id="backButton"
                        onAction="#handleRetour"
                        styleClass="back-profile-btn">

                    <graphic>

                        <FontIcon iconLiteral="fas-arrow-left"
                                  iconSize="20"
                                  iconColor="white"/>

                    </graphic>

                </Button>

                <!-- ===== Titre ===== -->

                <Label text="Profil utilisateur"
                       styleClass="profile-username"/>

            </children>

        </HBox>

    </top>

    <!-- ========================= CONTENU ========================= -->

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="25">

            <padding>
                <Insets top="25"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>

            <children>

                <!-- ========================= CARTE PROFIL ========================= -->

                <VBox alignment="CENTER"
                    spacing="12"
                    styleClass="profile-card"
                    prefWidth="420"
                    maxWidth="420">

                    <padding>
                        <Insets top="25"
                                right="25"
                                bottom="25"
                                left="25"/>
                    </padding>

                    <children>

                        <Circle radius="45"
                                fill="#5865f2"
                                styleClass="profile-avatar" />

                        <Label fx:id="usernameLabel"
                            text="Username"
                            styleClass="profile-username"/>

                        <TextField fx:id="usernameField"
                                promptText="Nouveau username"
                                styleClass="profile-input"/>
                        
                        <Label fx:id="passwordLabel"
                            styleClass="profile-username"/>

                        <javafx.scene.control.PasswordField fx:id="passwordField"
                                    promptText="Entrez votre mot de passe pour confirmer"
                                    styleClass="profile-input"/>

                        <Button text="Modifier username"
                                onAction="#handleUpdateUsername"
                                styleClass="btn-primary"/>

                    </children>

                </VBox>

                <!-- ========================= DISCUSSIONS MASQUÉES ========================= -->

                <VBox spacing="15"
                      prefWidth="550"
                      maxWidth="550"
                      VBox.vgrow="ALWAYS">

                    <children>

                        <!-- Titre section -->

                        <Label text="Discussions masquées"
                               styleClass="sidebar-title"/>


                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    styleClass="sidebar-scroll"
                                    VBox.vgrow="ALWAYS">

                            <content>

                                <VBox spacing="10"
                                      styleClass="hidden-scroll">

                                    <children>


                                        <ListView fx:id="hiddenDiscussionList"
                                                  prefHeight="350"
                                                  styleClass="hidden-list"/>

                                    </children>

                                </VBox>

                            </content>

                        </ScrollPane>

                    </children>


                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>