<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="messagerie_instantanee.UI.controllers.LoginControler"
            styleClass="login-root">

    <VBox mouseTransparent="true">
        <children>
            <Region VBox.vgrow="ALWAYS" styleClass="bg-top" prefHeight="2000.0" />
            <Region VBox.vgrow="ALWAYS" styleClass="bg-bottom" prefHeight="2000.0" />
        </children>
    </VBox>

    <BorderPane pickOnBounds="false">
        <center>
            <StackPane pickOnBounds="false">
                <children>
                
                <VBox fx:id="loginPane" alignment="CENTER" maxWidth="450" spacing="25" 
                    style="-fx-background-color: rgba(51, 51, 51); -fx-background-radius: 20; -fx-border-radius: 20;">
                    <padding>
                        <Insets bottom="50" left="50" right="50" top="50" />
                    </padding>
                    <children>
                        <Label text="Connexion au compte" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" />
                        
                        <VBox spacing="8" fillWidth="true">
                            <Label text="username" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                            <TextField style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                        </VBox>
                        
                        <VBox spacing="8" fillWidth="true">
                            <Label text="mot de passe" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                            <PasswordField style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                        </VBox>

                        <Label fx:id="errorLabel" wrapText="true" textAlignment="CENTER"
                               style="-fx-text-fill: #ff6b6b; -fx-font-size: 14; -fx-font-weight: bold;" />
                        
                        <Button text="Se connecter" onAction="#handleLogin" prefWidth="250"; styleclass="btn-connect" ;
                                style="-fx-background-color: #444; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 20; -fx-font-size: 16; -fx-cursor: hand;" />
                        
                        <Hyperlink text="Vous n'avez pas de compte ? Inscrivez-vous !" onAction="#showSignup" 
                                style="-fx-text-fill: #bbb; -fx-underline: false; -fx-font-size: 13;" />
                    </children>
                </VBox>

                <VBox fx:id="signupPane" alignment="CENTER" maxWidth="450" spacing="20" visible="false" managed="false"
                    style="-fx-background-color: rgba(51, 51, 51); -fx-background-radius: 20; -fx-border-radius: 20;">
                    <padding>
                        <Insets bottom="50" left="50" right="50" top="50" />
                    </padding>
                    <children>
                        <Label text="Création du compte" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" />
                        
                        <VBox spacing="6" fillWidth="true">
                            <Label text="username" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                            <TextField style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                        </VBox>
                        
                        <VBox spacing="6" fillWidth="true">
                            <Label text="mot de passe" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                            <PasswordField style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                        </VBox>
                        
                        <VBox spacing="6" fillWidth="true">
                            <Label text="confirmation mot de passe" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                            <PasswordField style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                        </VBox>

                        <Label fx:id="errorLabel" wrapText="true" textAlignment="CENTER"
                               style="-fx-text-fill: #ff6b6b; -fx-font-size: 14; -fx-font-weight: bold;" />
                        
                        <Button text="Créer le compte" onAction="#handleCreateAccount" prefWidth="250";styleclass="btn-connect" ;
                                style="-fx-background-color: #444; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 20; -fx-font-size: 16; -fx-cursor: hand;" />
                        
                        <Hyperlink text="Déjà un compte ? Connectez-vous" onAction="#showLogin" 
                                   style="-fx-text-fill: #bbb; -fx-underline: false; -fx-font-size: 13;" />
                    </children>
                </VBox>
                
            </children>
            </StackPane>
        </center>
        
        <right>
            <VBox fx:id="sidebarMenu" prefWidth="300.0" styleClass="sidebar-right" visible="false" managed="false">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="25.0" />
                </padding>
                <children>
                    <Label text="Serveur(s) utilisé(s)" styleClass="sidebar-title" />
                </children>
            </VBox>
        </right>
    </BorderPane>

    <StackPane alignment="TOP_RIGHT" pickOnBounds="false">
        <padding><Insets top="30" right="30"/></padding>
        <children>
            <Button onAction="#handleToggleSidebar" styleClass="icon-button-clean">
                <graphic>
                    <SVGPath content="M6 2H18C19.1 2 20 2.9 20 4V8C20 9.1 19.1 10 18 10H6C4.9 10 4 9.1 4 8V4C4 2.9 4.9 2 6 2ZM6 12H18C19.1 12 20 12.9 20 14V18C20 19.1 19.1 20 18 20H6C4.9 20 4 19.1 4 18V14C4 12.9 4.9 12 6 12Z" 
                            fill="#EDE3E3" scaleX="1.5" scaleY="1.5" />
                </graphic>
            </Button>
        </children>
    </StackPane>

</StackPane>