<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="messagerie_instantanee.UI.controllers.TitleBarController"
        fx:id="titleBar"
        styleClass="title-bar"
        alignment="CENTER_LEFT"
        prefHeight="32"
        onMousePressed="#handleMousePressed"
        onMouseDragged="#handleMouseDragged"
        onMouseReleased="#handleMouseReleased">

    <children>

        <!-- Icône de l'app -->
        <ImageView  fitWidth="24" fitHeight="24" preserveRatio="true">
            <image>
                <Image url="@../icons/logo-ogmos.png"/>
            </image>
            <HBox.margin><Insets left="12" right="8"/></HBox.margin>
        </ImageView>

        <!--
            Slot MenuBar — vide dans AuthView, rempli par TitleBarController.injectMenuBar()
            quand on navigue vers ChatView. Les handlers drag sont répétés pour que la zone
            reste draggable quand la MenuBar n'est pas injectée.
        -->
        <HBox fx:id="menuBarSlot"
              alignment="CENTER_LEFT"
              onMousePressed="#handleMousePressed"
              onMouseDragged="#handleMouseDragged"
              onMouseReleased="#handleMouseReleased"/>

        <!--
            Zone flexible : pickOnBounds="true" force JavaFX à détecter les clics
            même sur une région vide (sans contenu rendu).
            Les handlers sont répétés ici pour que le drag fonctionne
            même quand on clique sur cette zone et non sur le label.
        -->
        <Region HBox.hgrow="ALWAYS"
                pickOnBounds="true"
                onMousePressed="#handleMousePressed"
                onMouseDragged="#handleMouseDragged"
                onMouseReleased="#handleMouseReleased"/>

        <!-- Bouton Réduire -->
        <Button fx:id="minimizeBtn"
                onAction="#handleMinimize"
                styleClass="title-bar-btn">
            <graphic>
                <FontIcon iconLiteral="fas-minus" iconSize="11"/>
            </graphic>
        </Button>

        <!-- Bouton Agrandir / Restaurer -->
        <Button fx:id="maximizeBtn"
                onAction="#handleMaximize"
                styleClass="title-bar-btn">
            <graphic>
                <FontIcon fx:id="maximizeIcon" iconLiteral="fas-expand" iconSize="11"/>
            </graphic>
        </Button>

        <!-- Bouton Fermer -->
        <Button fx:id="closeBtn"
                onAction="#handleClose"
                styleClass="title-bar-btn-close">
            <graphic>
                <FontIcon iconLiteral="fas-times" iconSize="11"/>
            </graphic>
        </Button>

    </children>
</HBox>
