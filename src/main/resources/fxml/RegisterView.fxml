<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="messagerie_instantanee.UI.controllers.RegisterController"
            styleClass="login-root">

    <VBox mouseTransparent="true">
        <children>
            <Region VBox.vgrow="ALWAYS" styleClass="bg-top" prefHeight="2000.0" />
            <Region VBox.vgrow="ALWAYS" styleClass="bg-bottom" prefHeight="2000.0" />
        </children>
    </VBox>

    <BorderPane pickOnBounds="false">
        <center>
            <StackPane pickOnBounds="false">
                <children>
                    <VBox fx:id="signupPane" alignment="CENTER" maxWidth="450" spacing="20"
                    style="-fx-background-color: rgba(51, 51, 51); -fx-border-radius: 20;">
                    <padding>
                        <Insets bottom="50" left="50" right="50" top="50" />
                    </padding>
                        <children>
                            <Label text="Création du compte" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" />
                            
                            <VBox spacing="6" fillWidth="true">
                                <Label text="username" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                                <TextField fx:id="pseudoField"
                                    style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                            </VBox>
                            
                            <VBox spacing="6" fillWidth="true">
                                <Label text="mot de passe" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                                <PasswordField fx:id="passwordField"
                                    style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                            </VBox>
                            
                            <VBox spacing="6" fillWidth="true">
                                <Label text="confirmation mot de passe" style="-fx-text-fill: #ccc; -fx-font-size: 14;" />
                                <PasswordField fx:id="confirmPasswordField"
                                    style="-fx-background-color: #222; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 8;" />
                            </VBox>

                            <Label fx:id="errorLabel" wrapText="true" textAlignment="CENTER"
                                style="-fx-text-fill: #ff6b6b; -fx-font-size: 14; -fx-font-weight: bold;" />
                            
                            <Button text="Créer le compte" onAction="#handleCreateAccount" prefWidth="250" styleClass="btn-connect"
                                    style="-fx-background-color: #444; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 20; -fx-font-size: 16; -fx-cursor: hand;" />
                            
                            <Hyperlink text="Déjà un compte ? Connectez-vous" onAction="#showLogin" 
                                    style="-fx-text-fill: #bbb; -fx-underline: false; -fx-font-size: 13;" />

                            <Label styleClass="error"/>
                        </children>
                    </VBox>
                </children>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>