<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    TopBar.fxml — Barre d'icônes en haut à droite (thème + serveur)
    Inclus via <fx:include> dans AuthLayout.fxml (et potentiellement d'autres vues)

    Controller associé à créer :
        messagerie_instantanee.UI.controllers.TopBarController
    Méthodes attendues :
        - handleToggleTheme()   → bascule dark-theme / light-theme sur la scène
        - handleToggleSidebar() → appelle le parent (AuthLayoutController) pour afficher/masquer la sidebar
-->

<HBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="messagerie_instantanee.UI.controllers.TopBarController"
        spacing="15"
        pickOnBounds="false">
    <padding>
        <Insets top="25" right="25" bottom="0" left="0"/>
    </padding>
    <children>
        <!-- Bouton changement de thème -->
        <Button fx:id="themeBtn" onAction="#handleToggleTheme" styleClass="icon-button-clean">
            <graphic>
                <FontIcon iconLiteral="fas-fill-drip" iconSize="20" iconColor="white"/>
            </graphic>
        </Button>
        <!-- Bouton accès paramètres serveur -->
        <Button fx:id="sidebarBtn" onAction="#handleToggleSidebar" styleClass="icon-button-clean">
            <graphic>
                <FontIcon iconLiteral="fas-sliders-h" iconSize="20" iconColor="white"/>
            </graphic>
        </Button>
    </children>
</HBox>
