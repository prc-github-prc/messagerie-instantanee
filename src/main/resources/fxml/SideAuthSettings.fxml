<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    TopBar.fxml — Barre d'icônes en haut à droite (thème + serveur)
    Inclus via <fx:include> dans AuthLayout.fxml (et potentiellement d'autres vues)

    Controller associé à créer :
        messagerie_instantanee.UI.controllers.TopBarController
    Méthodes attendues :
        - handleToggleTheme()   → bascule dark-theme / light-theme sur la scène
        - handleToggleSidebar() → appelle le parent (AuthLayoutController) pour afficher/masquer la sidebar
-->
<HBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="messagerie_instantanee.UI.controllers.TopBarController"
        spacing="15"
        pickOnBounds="false">
    <padding>
        <Insets top="25" right="25" bottom="0" left="0"/>
    </padding>
    <VBox>
        <children>
            <!-- Bouton changement de thème -->
            <Button fx:id="themeBtn" onAction="#handleToggleTheme" styleClass="icon-button-clean">
                <graphic>
                    <FontIcon iconLiteral="fas-fill-drip" iconSize="20" iconColor="white"/>
                </graphic>
            </Button>
            <!-- Bouton accès paramètres serveur -->
            <Button fx:id="sidebarBtn" onAction="#handleToggleSidebar" styleClass="icon-button-clean">
                <graphic>
                    <FontIcon iconLiteral="fas-bookmark" iconSize="20" iconColor="white"/>
                </graphic>
            </Button>
        </children>
    </VBox>

    <!-- ================================ les deux paneau de settings ================================ -->
    <VBox fx:id="serveurSidebarMenu"
            styleClass="sidebar-right"
            visible="false"
            managed="false"
            maxHeight="Infinity"
            maxWidth="-Infinity">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="25.0"/>
        </padding>
        <children>
            <VBox>
                <!-- titre -->
                <Label text="Serveur(s) utilisé(s)" styleClass="sidebar-title"/>
                <!-- Champ serveur -->
                <VBox spacing="8" fillWidth="true">
                    <Label text="serveur" styleClass="input-label" style="-fx-font-size: 14;"/>
                    <TextField fx:id="serverField"
                            text="localhost"
                            styleClass="login-input"
                            style="-fx-padding: 12; -fx-background-radius: 8;"/>
                </VBox>
                <!-- liste des marque page -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS" styleClass="sidebar-scroll">
                    <content>
                        <VBox fx:id="BookMarkList">
                            <children>
                            <!-- example contenue : -->
                            <HBox>
                                <VBox>
                                    <Label text="nom_serv" styleClass="input-label" style="-fx-font-size: 14;"/>
                                    <Label text="IP" styleClass="input-label" style="-fx-font-size: 14;"/>
                                </VBox>
                                <Button onAction="#supression" styleClass="envoi-btn-container">
                                    <graphic>
                                        <StackPane>
                                            <children>
                                                <FontIcon iconLiteral="fas-trash" iconSize="30" iconColor="white"/>
                                            </children>
                                        </StackPane>
                                    </graphic>
                                </Button>
                            </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </children>
    </VBox>
</HBox>
