<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>

<BorderPane prefHeight="600.0" prefWidth="850.0" styleClass="chat-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="messagerie_instantanee.UI.ChatControle">    <left>
        <VBox prefWidth="220.0" styleClass="sidebar" spacing="10">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-title" text="FORUM DISCUSSION" />
                <Label styleClass="section-title" text="SALONS DISPONIBLES" />
                <ListView fx:id="salonList" VBox.vgrow="ALWAYS" styleClass="sidebar-list" />
                <VBox spacing="8" style="-fx-padding: 10px 0 0 0;">
                    <Button text="+ Ajouter un tag" onAction="#handleAjouterTag" styleClass="sidebar-btn" maxWidth="Infinity"/>
                    <Button text="+ Créer une discussion" onAction="#handleCreerDiscussion" styleClass="sidebar-btn" maxWidth="Infinity"/>
                    <Button text="+ Créer un salon" onAction="#handleCreerSalon" styleClass="sidebar-btn" maxWidth="Infinity"/>
                    <Button text="+ Créer un serveur" onAction="#handleCreerServeur" styleClass="sidebar-btn" maxWidth="Infinity"/>

                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox styleClass="chat-area" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="chat-header">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                    <children>
                        <Label fx:id="salonLabel" styleClass="chat-title" text="# Sélectionnez un salon" />
                    </children>
                </HBox>

                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="chat-scroll">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <content>
                        <VBox fx:id="messagesBox" spacing="12" styleClass="messages-container" />
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER" spacing="12" styleClass="input-bar">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <children>
                        <TextField fx:id="inputField" onAction="#actionEnvoi" promptText="Écrire un message dans ce salon…" styleClass="chat-input" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#actionEnvoi" styleClass="btn-primary" text="Envoyer" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>